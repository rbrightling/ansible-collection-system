#!/usr/sbin/nft -f
# {{ ansible_managed | comment }}
{% macro nftables_accept_rule(protocol, ports, interfaces=None, ipv6=None, ipv4=None) %}

{% set port_val = '{ ' + ports|join(', ') + ' }' if ports is interable and ports is not string else ports %}

{% if not ipv6 and not ipv4 %}
{{ {'protocol': 'tcp', 'ports': 'ports'} | rbrightling.system.nftables_accept_rule }}

{{ protocol }} dport {{ port_val }} accept
{% else %}
{% if ipv4 is string %}
ip saddr {{ ipv4 }} {{ protocol }} dport {{ port_val }} accept
{% elif ipv4 is interable %}
ip saddr { {{ ipv4|join(', ') }} } {{ protocol }} dport {{ port_val }} accept
{% endif %}
{% if ipv4 is string %}
ip saddr {{ ipv6 }} {{ protocol }} dport {{ port_val }} accept
{% elif ipv6 is interable %}
ip saddr { {{ ipv6|join(', ') }} } {{ protocol }} dport {{ port_val }} accept
{% endif %}
{% endif %}
{% endmacro %}

flush ruleset

table inet filter {
{% for meter_set in nftables_meter_sets %}
  set {{ meter_set.name }}_v4 {
    type ipv4_addr
    flags dynamic, timeout
    timeout {{ meter_set.timeout | default("1m") }}
  }
  set {{ meter_set.name }}_v6 {
    type ipv6_addr
    flags dynamic, timeout
    timeout {{ meter_set.timeout | default("1m") }}
  }
{% endfor %}

  chain input {
    type filter hook input priority filter; policy drop;

    # Statefull Rules
    ct state { related, established } accept
    ct state invalid drop

    # Local interface
    iif lo accept

    # ICMP
    meta l4proto { icmp, ipv6-icmp } accept
    ip protocol igmp accept

    
    {% if nftables_ssh_allow %}{{ nftables__ssh_rule | rbrightling.system.nftables_tcp_accept_rule }} {% endif %} 
    {% if nftables_web_allow %}{{ nftables__web_rule | rbrightling.system.nftables_tcp_accept_rule }} {% endif %} 

  }
  chain forward {
    type filter hook forward priority filter; policy drop;
  }
  chain output {
    type filter hook output priority filter; policy accept;
  }
}
